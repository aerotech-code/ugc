# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5433/chatapp
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=chatapp

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-characters
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-change-this-in-production-at-least-32-characters
REFRESH_TOKEN_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Chat Application
SMTP_FROM_EMAIL=noreply@chatapp.com

# AWS S3 Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=chatapp-uploads
AWS_S3_URL=https://chatapp-uploads.s3.amazonaws.com

# Kafka Configuration (Optional)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=chat-app-group

# Elasticsearch Configuration (Optional)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_TIMEOUT=3600000

# AI/ML Service (Optional)
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_API_KEY=your-ai-service-key

# Gemini LLM (Optional)
GEMINI_API_URL=https://api.example.com/v1/generate
GEMINI_API_KEY=your-gemini-api-key
