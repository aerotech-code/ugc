              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admissions/enrollment/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions", "enrollment", "confirm"]
            },
            "description": "Test case: missing required fields — should return 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 for missing fields', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Receipt - No Payment Done Yet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admissions/enrollment/550e8400-e29b-41d4-a716-000000000000/receipt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions", "enrollment", "550e8400-e29b-41d4-a716-000000000000", "receipt"]
            },
            "description": "Test case: requesting receipt for an app that hasn't paid fees — should return 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 when no receipt found', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unauthenticated Request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admissions/enrollment/{{appId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admissions", "enrollment", "{{appId}}"]
            },
            "description": "Test case: request without Authorization header — should return 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 for unauthenticated request', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
